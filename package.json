{
  "name": "zaa-tool",
  "version": "1.0.0",
  "description": "Self-hosted automation where the unit of work is a notebook — readable top to bottom, callable by agents over MCP.",
  "scripts": {
    "test": "pnpm -r --sequential run test",
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @zaa-tool/web run dev",
    "dev:engine": "pnpm --filter @zaa-tool/engine run dev"
  },
  "devDependencies": {
    "@types/node": "^24.13.2"
  },
  "keywords": [
    "automation",
    "workflow",
    "notebook",
    "mcp",
    "self-hosted",
    "low-code"
  ],
  "author": "Afriza Gilleon Ginting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/afrizagilleon/zaatool.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.6.0",
      "onFail": "download"
    }
  },
  "type": "module"
}