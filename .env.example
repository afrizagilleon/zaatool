# Copy to `.env` and fill in the two that have no default.
#
#   cp .env.example .env
#
# Everything here is read by docker compose. For `pnpm dev` on your own machine none of it
# is required — the engine falls back to a development secret and says so on startup.

# ── the two that matter ───────────────────────────────────────────────────────

# The engine will not start in production without this, and will not accept anything
# shorter than 32 characters. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it signs every session out and invalidates every share link and file link.
JWT_SECRET=

# The key the secrets table is encrypted with (AES-256-GCM): 64 hex characters. The engine
# will not start in production without it. Generate one:
#
#   openssl rand -hex 32
#
# Lose it and every stored secret is lost: keep a copy apart from your database backups.
# Changing it by hand makes the engine refuse to start; to change it, run
# `rotate-secrets-key` (see DEPLOY.md).
SECRETS_KEY=

# The database password. Changing it after the first run means changing it in the volume
# too, so pick it now.
POSTGRES_PASSWORD=

# ── the rest have working defaults ────────────────────────────────────────────

# Which release of the engine and web images docker compose pulls from GHCR. `latest` follows
# the newest release; a tag such as v1.2.0 stays put until you change it (scripts/update.sh
# --version v1.3.0 does that for you). install.sh sets it to the version it installed.
# ZAATOOL_VERSION=latest

# Only with the bundled Caddy (scripts/install.sh --with-caddy, which sets these two): the
# name Caddy gets a certificate for, and the compose profile that switches Caddy on.
# PUBLIC_DOMAIN=
# COMPOSE_PROFILES=caddy

# Each container keeps at most LOG_MAX_FILE log files of LOG_MAX_SIZE each (docker's json-file
# driver), so logs cannot fill the disk: 10 x 50m by default per container. That is days to
# weeks on a small install, not months; ship the logs elsewhere if you need longer (DEPLOY.md,
# "Logs").
# LOG_MAX_SIZE=50m
# LOG_MAX_FILE=10

# What the engine writes to its operational log. LOG_LEVEL is debug, info, warn or error
# (default info; debug adds the health probe and is noisy). LOG_FORMAT is json (default, one
# object per line) or pretty (a readable line, for a terminal).
# LOG_LEVEL=info
# LOG_FORMAT=json

# POSTGRES_USER=zaa_user
# POSTGRES_DB=zaa_tool
# POSTGRES_PORT=5432

# Where the app is served. Put a reverse proxy with TLS in front of this.
# WEB_PORT=8080

# The address the web port is bound to on the host. The default, 127.0.0.1, is reachable
# from this machine only — which is what a reverse proxy on the same host (Caddy) needs.
# Use 0.0.0.0 only to try the stack directly, with no proxy in front (then also set
# COOKIE_SECURE=false unless you have TLS, and TRUST_PROXY=1).
# WEB_BIND=127.0.0.1

# Resource ceiling for the engine container (it runs every cell), so a runaway notebook
# cannot take the other services on this machine down with it.
# ENGINE_MEMORY_LIMIT=2g
# ENGINE_CPU_LIMIT=2
# Most processes and threads the whole engine container may have (engine and every cell).
# ENGINE_PIDS_LIMIT=4096

# The code that lets the very first account be created. While no account exists the engine
# prints a random one-time code to its log (docker compose logs engine | grep -i setup; it is the `auth.setup_code` line) and
# registration needs it. Set this only to choose the code yourself (automation); anyone who
# knows it can claim the installation until the first account exists. It means nothing once
# there is a user. `pnpm create-user` never needs it.
# SETUP_CODE=

# Open the sign-up form. Turn it on to let the first person in, then turn it off — an
# installation with no users at all always accepts the first one regardless.
# ALLOW_REGISTRATION=false

# Whether the session cookie (zaa_session) carries the `Secure` flag, so a browser sends it
# over HTTPS only. Leave unset in a real deployment: it is on whenever the engine runs in
# production, which compose does. Set `false` only to try the stack over plain HTTP
# (http://host:8080 with no TLS in front) — a browser refuses to send a Secure cookie back
# over HTTP, so sign-in would seem to work and the next request would be signed out.
# COOKIE_SECURE=

# The largest file a page, a webhook or a cell may write.
# MAX_UPLOAD_MB=25

# The largest JSON body most routes accept, including the ones with no login (webhooks,
# shared pages, MCP). Raise it only if a caller really sends that much.
# MAX_JSON_BODY_MB=1

# The same, for /api/notebooks only (saving a document, run arguments that carry tables).
# MAX_NOTEBOOK_JSON_MB=50

# The longest one notebook run may take in total, in seconds, nested notebooks.run calls
# included. A cell's own timeout stops counting while it waits on another notebook, so this
# is what ends a run that keeps calling out forever. When it runs out every cell in the
# chain is stopped and the run fails.
# MAX_RUN_SECONDS=900

# Memory limit, in MB, of one JavaScript cell (each runs in its own process): the V8 heap
# (--max-old-space-size) and, on Linux with the sandbox on, the kernel also caps the whole
# process at this plus the ~640 MB a bare Node reserves, so large Buffers count too. A cell
# that goes past it fails with an out-of-memory error; the engine carries on.
# MAX_CELL_MEMORY_MB=512
# The same for one Python cell (Linux, sandbox on): its private memory, numpy arrays included.
# Its own variable because a pandas or numpy cell legitimately needs more than a JavaScript one.
# MAX_PYTHON_CELL_MEMORY_MB=1024
# Linux, sandbox on: most processes and threads one cell process may have (the cell and
# everything it starts: every cell process has a uid of its own, and the kernel counts per
# uid), and the largest single file (MB) a cell may write. Cells also run with core dumps off.
# ENGINE_PIDS_LIMIT (4096) is room for 32 cells all at this limit, for the whole container.
# MAX_CELL_PROCESSES=128
# MAX_CELL_FILE_MB=1024
# Disk one notebook owner's cells may fill (MB): their temp folder and package cache together,
# measured before each cell. Over it, the owner's next cell is refused with a message; their temp
# folder is emptied a few minutes after their last cell, and a package cache past half of this is
# pruned. Default 2048.
# MAX_OWNER_DISK_MB=2048

# Linux, Docker, sandbox on: cells are firewalled by uid. They reach the internet and DNS and
# are REFUSED this engine's own port, the database and every other container, the cloud
# metadata address (169.254.169.254) and the private ranges (10/8, 172.16/12, 192.168/16,
# 100.64/10, loopback; fc00::/7 and fe80::/10 for IPv6). CELL_EGRESS_ALLOW opens named
# exceptions: a comma-separated list of CIDRs (10.1.2.0/24) and/or host:port (a name is resolved
# once, when the container starts). A malformed entry stops the container with the reason.
# CELL_EGRESS_FIREWALL=off starts without the firewall, with a loud warning: only for a host
# whose own network already does this job. The engine refuses to start if the firewall is on
# but missing. Needs cap_add: NET_ADMIN, which docker-compose.yml has.
# CELL_EGRESS_ALLOW=
# CELL_EGRESS_FIREWALL=on

# Linux, sandbox on: the same three limits for the `uv` that installs a notebook's packages
# (at deploy, and when a run first needs the environment). Looser than a cell's because
# installing is not the notebook's own work: uv runs a thread per core, builds from source and
# unpacks wheels over a gigabyte. They still stop a build script that forks or writes without end.
# MAX_INSTALL_MEMORY_MB=4096
# MAX_INSTALL_PROCESSES=1024
# MAX_INSTALL_FILE_MB=4096

# Linux only: the unprivileged users cells (and the uv run that installs a notebook's packages)
# are spawned as. Every notebook owner has a group of its own, handed out the first time that
# owner's notebook runs: SANDBOX_UID_BASE, then the next one, SANDBOX_UID_COUNT in all (when
# they are used up, new owners' notebooks fail with a message that says so). Every cell
# *process* has a uid of its own, taken from the same range for as long as it runs and swept
# clean (everything it left running or in /dev/shm killed or removed) before it is used again,
# so SANDBOX_UID_COUNT is also how many cells can run at once. SANDBOX_GID is the sandbox's own
# group: it switches the sandbox on and names the group files had before owners had one.
# Each owner gets SANDBOX_HOME/owners/<gid>, closed to everyone else. The engine must be root
# to switch, and refuses to start if it is not. The Docker image sets these; leave them unset
# on a dev machine, and they are ignored on Windows. The old SANDBOX_UID is gone: the engine
# refuses to start while it is set. The container also needs cap_add: [SYS_RESOURCE] (compose
# has it) so a cell cannot undo the engine making it the first thing the kernel's OOM killer
# picks; without it the engine warns at start.
# SANDBOX_UID_BASE=20000
# SANDBOX_UID_COUNT=40000
# SANDBOX_GID=10001
# SANDBOX_HOME=/home/sandbox

# How many notebooks.run calls one run may have executing at once. Each costs a process
# (JavaScript or Python); the rest of a burst waits its turn.
# MAX_NESTED_CONCURRENCY=4

# How many notebooks.run calls one run may make in all. The next one fails inside the cell.
# MAX_NESTED_CALLS=200

# The engine runs 4 notebooks at once and queues 20 more. One account's notebooks may hold
# only part of that, so a webhook hit in a loop cannot make everybody else wait or be
# refused. Defaults: half the slots (2) and half the queue (10).
# MAX_RUNS_PER_OWNER=2
# MAX_QUEUED_RUNS_PER_OWNER=10

# Which proxies the engine believes when it reads X-Forwarded-For. The login and webhook
# limiters count per client address; behind nginx that address only exists in that header.
# docker compose sets 1: nginx and nobody else (add one for each proxy in front of nginx).
# Without compose the engine's default trusts loopback and private networks (local dev).
# `false` trusts no one; a number is a hop count; or list subnets. Never `true`.
# TRUST_PROXY=1

# Shown on the Resources page. `scripts/update.sh --build` fills these in from git (release images carry theirs from the tag).
# BUILD_VERSION=
# BUILD_COMMIT=

# The one time zone every cron trigger is read in (IANA name, e.g. Asia/Jakarta). Default UTC.
# "0 9 * * *" means 09:00 in this zone, not in the server's or the browser's. An unknown
# name makes the engine refuse to start. Schedules missed while the engine was down are
# not replayed.
# CRON_TZ=UTC

# How long a deploy waits for `uv` to resolve a Python notebook's `packages:` before it
# kills it and refuses the deploy with a timeout error. Default 120 seconds; raise it for
# very large packages on a slow connection.
# UV_LOCK_TIMEOUT_SECONDS=120

# Finished runs older than this many days are deleted (on top of the cap of 50 per notebook).
# A run keeps what its cells printed and returned, so it is not kept forever. Runs still in
# progress are never deleted.
# RUN_RETENTION_DAYS=90

# How many days of the audit trail (who changed what, who was refused) are kept. Default 400,
# a year plus a margin; 0 keeps everything. A daily job removes older rows; export first
# (GET /api/audit/export?format=jsonl, creators only) if they must outlive it. Check the trail
# has not been altered with `pnpm audit-verify` inside the engine container.
# AUDIT_RETENTION_DAYS=400
