# Copy to `.env` and fill in the two that have no default.
#
#   cp .env.example .env
#
# Everything here is read by docker compose. For `pnpm dev` on your own machine none of it
# is required — the engine falls back to a development secret and says so on startup.

# ── the two that matter ───────────────────────────────────────────────────────

# The engine will not start in production without this, and will not accept anything
# shorter than 32 characters. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it signs every session out and invalidates every share link and file link.
JWT_SECRET=

# The database password. Changing it after the first run means changing it in the volume
# too, so pick it now.
POSTGRES_PASSWORD=

# ── the rest have working defaults ────────────────────────────────────────────

# POSTGRES_USER=zaa_user
# POSTGRES_DB=zaa_tool
# POSTGRES_PORT=5432

# Where the app is served. Put a reverse proxy with TLS in front of this.
# WEB_PORT=8080

# Open the sign-up form. Turn it on to let the first person in, then turn it off — an
# installation with no users at all always accepts the first one regardless.
# ALLOW_REGISTRATION=false

# The largest file a page, a webhook or a cell may write.
# MAX_UPLOAD_MB=25

# Shown on the Resources page. `scripts/update.sh` fills these in from git.
# BUILD_VERSION=
# BUILD_COMMIT=
